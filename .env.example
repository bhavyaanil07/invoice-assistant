# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Email of a sandbox PERSONAL (buyer) account located OUTSIDE India
TEST_CLIENT_EMAIL=your_sandbox_buyer_email@personal.example.com

# Webhook ID from your app's Webhooks section (needed only on a public URL)
PAYPAL_WEBHOOK_ID=your_webhook_id

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash